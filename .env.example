# Knitter Marketplace: copy this file to .env and fill in your own values.
# Never commit .env. This example file is safe to commit.

# Ravelry API, read-only app (patterns and yarns)
RAVELRY_READ_USERNAME=read-xxxxxxxxxxxxxxxx
RAVELRY_READ_PASSWORD=

# Ravelry API, personal account app (stash). Leave empty if not used.
RAVELRY_PERSONAL_USERNAME=
RAVELRY_PERSONAL_PASSWORD=
RAVELRY_ACCOUNT_NAME=

# Claude API (pattern extraction)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Nebius Token Factory (decision step). Leave empty to use Claude instead.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_MODEL=

# Tavily (substitute search, Ravelry page fallback)
TAVILY_API_KEY=

# idealo MCP uses OAuth in the browser, no key needed here
IDEALO_MCP_URL=https://mcp.idealo.com/mcp
IDEALO_COUNTRY=DE

# Budget defaults (EUR)
BUDGET_MAX_TOTAL_EUR=60
BUDGET_MAX_PER_100M_EUR=4.0
